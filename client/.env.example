# Development Mode (npm run dev)
VITE_API_URL=http://localhost:5000/api/v1
VITE_AI_API_URL=http://localhost:8000/api/v1/ai
VITE_SOCKET_URL=http://localhost:5000

# Production Mode (Docker / Nginx / EC2)
# In production, leave these empty or use relative paths (/api/v1, /api/v1/ai, "")
# to ensure Nginx handles all reverse proxying automatically on any host or domain.
